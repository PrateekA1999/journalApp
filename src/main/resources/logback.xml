<configuration>

    <conversionRule conversionWord="highlightex" converterClass="com.prateek.journalApp.config.CustomHighlighter" />

    <property name="PID" value="${PID:-unknown}" />

    <appender name = "myConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <encoder>
            <pattern>
                %d{yy-MM-dd HH:mm:ss.SSS} %highlightex(%-5level) %property{PID} --- %boldBlue([%thread])  %boldMagenta([%logger{36}])  : %highlightex(%msg) %n %highlightex(%throwable)
            </pattern>
        </encoder>
    </appender>

    <appender name = "myFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>
            logs/journalApp.log
        </file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
          <!-- <fileNamePattern>logs/journalApp-%d{yy-MM-dd_HH-mm}.%i.log</fileNamePattern> -->
            <fileNamePattern>logs/journalApp-%d{yy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>
                %d{yy-MM-dd HH:mm:ss.SSS} %-5level {PID} --- [%thread]  [%logger{36}]  : %msg %n
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="myConsoleAppender" />
        <appender-ref ref="myFileAppender" />
    </root>


</configuration>